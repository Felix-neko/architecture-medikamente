@startuml classification_engine_c2
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' Стили
AddElementTag("engine", $bgColor="#438DD5", $borderColor="#3C7FC0", $fontColor="white")
AddElementTag("third-party", $bgColor="#f5f5f5", $borderColor="DarkGray", $fontColor="Black")
AddElementTag("parent-company", $bgColor="#FFE4B5", $borderColor="#D2691E", $fontColor="Black")
AddElementTag("storage", $bgColor="#CCE5FF", $borderColor="#3399FF", $fontColor="Black")

title Classification Engine — C2 Container Diagram

' ============ ВЕРХ: Источники данных (горизонтально) ============
together {
    ContainerDb(postgres_crm, "CRM DB", "PostgreSQL", "Пациенты, записи", $tags="storage")
    ContainerDb(postgres_med, "Med Record DB", "PostgreSQL", "Медкарты, диагнозы", $tags="storage")
    ContainerDb(minio_src, "MinIO medrecords", "S3", "Файлы МК", $tags="storage")
    Container(openmetadata, "OpenMetadata", "Data Catalog", "Схема, теги", $tags="third-party")
}

' Скрытые связи для горизонтального расположения источников
postgres_crm -[hidden]r-> postgres_med
postgres_med -[hidden]r-> minio_src
minio_src -[hidden]r-> openmetadata

' ============ ЦЕНТР: Apache Airflow (рамка) ============
System_Boundary(airflow_system, "Apache Airflow") {
    
    ' DAG 1: ETL для ClickHouse (горизонтально)
    together {
        Container(schema_discovery, "1. Schema\nDiscovery", "Python", "Проверка схемы", $tags="engine")
        Container(ch_loader_raw, "2. Load\nraw_data", "Python", "INSERT в raw", $tags="engine")
        Container(extra_filter, "3. Extra\nFilter", "Python", "ВИЧ/психиатрия", $tags="engine")
        Container(data_anonymizer, "4. Anonymizer", "Python", "SHA-256, FPE", $tags="engine")
        Container(dlp_db, "5. DLP\nCheck", "Python", "Проверка ПДн", $tags="engine")
        Container(ch_loader_approved, "6. Load\napproved", "Python", "INSERT в слои", $tags="engine")
    }
    
    ' DAG 2: ETL для файлов (горизонтально)
    together {
        Container(file_scanner, "1. File\nScanner", "Python", "Список файлов", $tags="engine")
        Container(file_anonymizer, "2. File\nAnonymizer", "Python", "Blur, редакция", $tags="engine")
        Container(dlp_files, "3. DLP Check\nFiles", "Python", "Проверка файлов", $tags="engine")
        Container(file_copier, "4. File\nCopier", "Python", "COPY approved", $tags="engine")
    }
}

' ============ СПРАВА: InfoWatch (вне Airflow) ============
Container(infowatch, "InfoWatch\nTraffic Monitor", "DLP System", "Проверка на ПДн", $tags="parent-company")

' ============ НИЗ: Целевые хранилища (горизонтально) ============
together {
    ContainerDb(ch_raw, "raw_data", "ClickHouse", "С ПДн (admin)", $tags="storage")
    ContainerDb(ch_anon, "anonymized", "ClickHouse", "Обезличенные", $tags="storage")
    ContainerDb(ch_approved, "dlp_approved", "ClickHouse", "Без ПДн", $tags="storage")
    ContainerDb(minio_approved, "dlp_approved\n_files", "MinIO", "Файлы без ПДн", $tags="storage")
}

' Скрытые связи для горизонтального расположения целевых
ch_raw -[hidden]r-> ch_anon
ch_anon -[hidden]r-> ch_approved
ch_approved -[hidden]r-> minio_approved

' ============ СВЯЗИ DAG 1 (горизонтально) ============
schema_discovery -r-> ch_loader_raw : ""
ch_loader_raw -r-> extra_filter : ""
extra_filter -r-> data_anonymizer : ""
data_anonymizer -r-> dlp_db : ""
dlp_db -r-> ch_loader_approved : ""

' ============ СВЯЗИ DAG 2 (горизонтально) ============
file_scanner -r-> file_anonymizer : ""
file_anonymizer -r-> dlp_files : ""
dlp_files -r-> file_copier : ""

' ============ Источники → DAG 1 ============
Rel_D(postgres_crm, schema_discovery, "SELECT", "JDBC")
Rel_D(postgres_med, schema_discovery, "SELECT", "JDBC")
Rel_D(openmetadata, schema_discovery, "Теги", "REST")

' ============ Источники → DAG 2 ============
Rel_D(minio_src, file_scanner, "LIST", "S3 API")

' ============ DAG 1 → Целевые ============
Rel_D(ch_loader_raw, ch_raw, "INSERT")
Rel_D(ch_loader_approved, ch_anon, "INSERT")
Rel_D(ch_loader_approved, ch_approved, "INSERT")

' ============ DAG 2 → Целевые ============
Rel_D(file_copier, minio_approved, "COPY")

' ============ DLP-проверка (InfoWatch) ============
Rel_R(dlp_db, infowatch, "REST API")
Rel_R(dlp_files, infowatch, "REST API")

@enduml
