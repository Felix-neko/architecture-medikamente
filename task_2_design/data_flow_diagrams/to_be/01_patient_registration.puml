@startuml
' Диаграмма потока данных: Регистрация пациента через веб-приложение (TO-BE)
left to right direction
title DFD: Регистрация пациента (самостоятельно через веб-приложение)

!define process rectangle

skinparam rectangle {
    RoundCorner 20
    BackgroundColor #CCFFCC
    BorderColor Black
}

skinparam rectangle<<external_process>> {
    RoundCorner 20
    BackgroundColor #E0E0E0
    BorderColor Black
}

skinparam database {
    BackgroundColor #CCE5FF
}
skinparam database<<external>> {
    BackgroundColor #E0E0E0
}

' -----------------------------------------------------------
' УЧАСТНИКИ И ДАННЫЕ
' -----------------------------------------------------------
actor "Пациент" as patient

database "CRM DB\n(PostgreSQL)" as crm_db
database "Consent DB\n(PostgreSQL)" as consent_db
database "MinIO\n(файлы МК)" as minio
database "Keycloak DB" <<external>> as keycloak_db
database "Google\nAuthenticator" <<external>> as google_auth

' -----------------------------------------------------------
' ПРОЦЕССЫ
' -----------------------------------------------------------
process "Web App\n(форма регистрации)" as webapp
process "Keycloak\n(создание аккаунта)" as keycloak
process "CRM API\n(проверка дубликата)" as crm_check
process "CRM API\n(сохранение)" as crm_save
process "Consent Manager API\n(сохранение ИС)" as consent_save

' -----------------------------------------------------------
' ПОТОКИ ДАННЫХ
' -----------------------------------------------------------
patient --> webapp : ФИО, паспорт,\nтелефон, email
webapp --> keycloak : email, телефон,\nпароль
keycloak --> keycloak_db : Создание\nаккаунта
keycloak --> google_auth : TOTP/HOTP\ncredential
webapp --> crm_check : Паспортные\nданные
crm_check <-- crm_db : Поиск\nдубликата
crm_check --> crm_save : Новый пациент
crm_save --> crm_db : Зашифрованные\nПДн
crm_save --> minio : Создание\n/patient_uuid/
webapp --> consent_save : Информированное\nсогласие
consent_save --> consent_db : Сохранение ИС

@enduml
