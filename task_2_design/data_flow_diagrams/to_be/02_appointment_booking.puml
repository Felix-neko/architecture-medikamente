@startuml
' Диаграмма потока данных: Запись на приём (TO-BE)
left to right direction
title DFD: Запись на приём (TO-BE)

!define process rectangle

skinparam rectangle {
    RoundCorner 20
    BackgroundColor #CCFFCC
    BorderColor Black
}

skinparam rectangle<<external_process>> {
    RoundCorner 20
    BackgroundColor #E0E0E0
    BorderColor Black
}

skinparam database {
    BackgroundColor #CCE5FF
}
skinparam database<<external>> {
    BackgroundColor #E0E0E0
}

' -----------------------------------------------------------
' УЧАСТНИКИ И ДАННЫЕ
' -----------------------------------------------------------
actor "Пациент" as patient

database "CRM DB\n(PostgreSQL)" as crm_db
database "Consent DB\n(PostgreSQL)" as consent_db
database "SMS/Email\nшлюз" <<external>> as notification

' -----------------------------------------------------------
' ПРОЦЕССЫ
' -----------------------------------------------------------
process "Web App\n(выбор времени)" as webapp
process "Auth Proxy\n(добавляет JWT)" as auth_proxy
process "CRM API\n(создание записи)" as crm_create
process "Consent Manager API\n(проверка ИС)" as consent_check
process "Consent Manager API\n(подписание ИС)" as consent_sign
process "Отправка\nуведомления" as send_notify

' -----------------------------------------------------------
' ПОТОКИ ДАННЫХ
' -----------------------------------------------------------
patient --> webapp : UUID пациента,\nUUID специалиста,\nвремя записи
webapp --> auth_proxy : Запрос на\nзапись
auth_proxy --> auth_proxy : Добавление JWT\nс ролями
auth_proxy --> crm_create : Данные записи\n+ JWT
crm_create --> crm_db : INSERT appointments\n(время, patient_uuid,\nspecialist_uuid)
webapp --> consent_check : Проверка ИС\nна специалиста
consent_check <-- consent_db : Поиск\nдействующего ИС
consent_check --> webapp : ИС есть?\n(да/нет)
webapp --> consent_sign : Подписание\nнового ИС
consent_sign --> consent_db : Сохранение ИС
crm_create --> send_notify : Данные для\nуведомления
send_notify --> notification : SMS/Email

@enduml
