@startuml
' Диаграмма потока данных: Регистрация пациента через регистратуру (TO-BE)
left to right direction
title DFD: Регистрация пациента (через администратора регистратуры)

!define process rectangle

skinparam rectangle {
    RoundCorner 20
    BackgroundColor #CCFFCC
    BorderColor Black
}

skinparam rectangle<<external_process>> {
    RoundCorner 20
    BackgroundColor #E0E0E0
    BorderColor Black
}

skinparam database {
    BackgroundColor #CCE5FF
}
skinparam database<<external>> {
    BackgroundColor #E0E0E0
}

' -----------------------------------------------------------
' УЧАСТНИКИ И ДАННЫЕ
' -----------------------------------------------------------
actor "Пациент" as patient
actor "Администратор" as admin

database "CRM DB\n(PostgreSQL)" as crm_db
database "Consent DB\n(PostgreSQL)" as consent_db
database "MinIO\n(файлы МК)" as minio
database "Keycloak DB" <<external>> as keycloak_db

' -----------------------------------------------------------
' ПРОЦЕССЫ
' -----------------------------------------------------------
process "Keycloak\n(логин админа)" as keycloak_login
process "Web App\n(форма CRM)" as webapp
process "CRM API\n(проверка дубликата)" as crm_check
process "CRM API\n(сохранение)" as crm_save
process "CRM API\n(создание аккаунта)" as crm_create_account
process "Keycloak\n(новый аккаунт)" as keycloak_new
process "Consent Manager API\n(создание ИС)" as consent_create

' -----------------------------------------------------------
' ПОТОКИ ДАННЫХ
' -----------------------------------------------------------
patient --> admin : Диктует\nпаспортные данные
admin --> keycloak_login : Логин/пароль\nадмина
keycloak_login <-- keycloak_db : Проверка\nучётных данных
admin --> webapp : Ввод паспортных\nданных пациента
webapp --> crm_check : Паспортные\nданные
crm_check <-- crm_db : Поиск\nдубликата
crm_check --> crm_save : Новый пациент
crm_save --> crm_db : Зашифрованные\nПДн
crm_save --> minio : Создание\n/patient_uuid/
crm_save --> crm_create_account : patient_uuid
crm_create_account --> keycloak_new : Создание аккаунта\n+ одноразовый пароль
keycloak_new --> keycloak_db : Сохранение\nаккаунта
patient --> admin : Подписывает ИС\nна бумаге
admin --> consent_create : Создание ИС\nчерез Web App
consent_create --> consent_db : Сохранение ИС

@enduml
