@startuml
' Диаграмма потока данных: Оплата медицинских процедур (TO-BE)
left to right direction
title DFD: Оплата медицинских процедур (TO-BE)

!define process rectangle

skinparam rectangle {
    RoundCorner 20
    BackgroundColor #CCFFCC
    BorderColor Black
}

skinparam rectangle<<external_process>> {
    RoundCorner 20
    BackgroundColor #E0E0E0
    BorderColor Black
}

skinparam database {
    BackgroundColor #CCE5FF
}
skinparam database<<external>> {
    BackgroundColor #E0E0E0
}

' -----------------------------------------------------------
' УЧАСТНИКИ И ДАННЫЕ
' -----------------------------------------------------------
actor "Пациент" as patient
actor "Кассир" as cashier

database "CRM DB\n(PostgreSQL)" as crm_db
database "1С БД" <<external>> as c1_db

' -----------------------------------------------------------
' ПРОЦЕССЫ
' -----------------------------------------------------------
process "Web App\n(поиск записи)" as webapp
process "Auth Proxy" as auth_proxy
process "CRM API\n(поиск записи)" as crm_search
process "CRM API\n(отметка оплаты)" as crm_update
process "1С: Бухгалтерия\n(формирование счёта)" <<external_process>> as c1_app
process "ККМ\n(приём оплаты)" <<external_process>> as kkm

' -----------------------------------------------------------
' ПОТОКИ ДАННЫХ
' -----------------------------------------------------------
cashier --> webapp : Поиск по\nФИО/телефону/времени
webapp --> auth_proxy : Запрос
auth_proxy --> crm_search : Поиск записи
crm_search <-- crm_db : Данные записи
crm_search --> cashier : Информация\nо записи
cashier --> c1_app : Вручную вводит\n№ записи
c1_app --> c1_db : Формирование\nсчёта
c1_app --> kkm : Данные\nдля оплаты
patient --> kkm : Оплата\n(карта/наличные)
kkm --> patient : Чек
cashier --> webapp : Отметка\nоб оплате
webapp --> auth_proxy : Запрос
auth_proxy --> crm_update : UPDATE
crm_update --> crm_db : payment_status\n= paid

@enduml
